# このファイルをコピーして .env.local を作り、実際の値を入れる（.env.local はコミットしない）
# 値はいずれも公開情報（anon keyはRLSで保護される前提）だが、環境ごとの切り替えのため env 化している

VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=xxxxxxxx

# LINE Developers のチャネルID（AshiBase資材管理と共有する既存チャネル）
VITE_LINE_CHANNEL_ID=xxxxxxxx

# LINEログインの redirect_uri。デプロイ先アプリのURLそのもの（末尾スラッシュ込み）
# 例: https://genki1414.github.io/sekisan/
VITE_LINE_REDIRECT_URI=https://xxxxxxxx/

# line-login Edge FunctionのURL
# 例: https://xxxxxxxx.supabase.co/functions/v1/line-login
VITE_LINE_LOGIN_FUNCTION_URL=https://xxxxxxxx.supabase.co/functions/v1/line-login

# create-checkout-session Edge FunctionのURL
# 例: https://xxxxxxxx.supabase.co/functions/v1/create-checkout-session
VITE_CHECKOUT_FUNCTION_URL=https://xxxxxxxx.supabase.co/functions/v1/create-checkout-session

# create-portal-session Edge FunctionのURL（契約管理・解約用）
# 例: https://xxxxxxxx.supabase.co/functions/v1/create-portal-session
VITE_PORTAL_FUNCTION_URL=https://xxxxxxxx.supabase.co/functions/v1/create-portal-session

# zaimu-bridge Edge FunctionのURL（AshiBase資材管理への送信連携用）
# 例: https://xxxxxxxx.supabase.co/functions/v1/zaimu-bridge
VITE_ZAIMU_BRIDGE_FUNCTION_URL=https://xxxxxxxx.supabase.co/functions/v1/zaimu-bridge

# AshiBase資材管理アプリのURL（プラン未加入時のアップグレード導線リンク先）
VITE_ZAIMU_APP_URL=https://ashibase.jp
